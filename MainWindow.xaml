<Window x:Class="CyberAwarenessBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="South African Cyber-Safety Assistant"
        Height="700"
        Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#3A3F44"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">



          <TextBlock FontFamily="Consolas"
                       FontSize="12"
                       Background="#3A3F44"
                       Foreground="#FF007F"
                       Padding="15"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       TextAlignment="Left"
                       TextWrapping="NoWrap">
|---------------------------------------------------------|
|                | CYBER GUARD SA - CYBER                 |
|    | o  o |   Secure Bot Active                         |
|    |  __  |                                             |
|    | /  \ |   Monitoring Systems                        |
|    |------|                                             |
|---------------------------------------------------------|
            </TextBlock>










        </Border>

        <!-- Chat Area -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ChatScrollContainer"
                      VerticalScrollBarVisibility="Auto">

            <TextBox x:Name="ChatLogDisplay"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     Padding="12"
                     Background="White"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     VerticalScrollBarVisibility="Disabled"/>
        </ScrollViewer>

        <!-- Input Area -->
        <Grid Grid.Row="2" Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInputTextBox"
                     Grid.Column="0"
                     Height="45"
                     FontSize="14"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     KeyDown="UserInputTextBox_KeyDown"/>

            <Button x:Name="SubmitButton"
                    Content="SEND"
                    Grid.Column="1"
                    Width="90"
                    Margin="12,0,0,0"
                    Background="#3A8E7A"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Click="SubmitButton_Click"/>

        </Grid>

    </Grid>
</Window>





















